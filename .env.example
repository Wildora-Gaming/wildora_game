# Copie para .env (na raiz) e preencha. NUNCA suba o .env para o GitHub.
# Sem nada preenchido o jogo roda em modo local: login por nome + senha e progresso em server/data/.

PORT=2567

# --- Supabase (login por e-mail) ---
# Supabase → Project Settings → API (ou "API Keys")
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave pública: "Publishable key" (sb_publishable_...) ou a "anon" antiga. Pode ir para o navegador.
SUPABASE_ANON_KEY=

# --- Banco (onde fica o progresso: criaturas, níveis, itens, insígnias) ---
# Supabase → botão "Connect" → "Session pooler" (funciona em IPv4). Troque [YOUR-PASSWORD].
# Esta é SECRETA: só no servidor (Render/Oracle), nunca no cliente nem no chat.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
