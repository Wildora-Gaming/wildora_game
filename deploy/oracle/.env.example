# Copie para .env nesta pasta (deploy/oracle/.env) e preencha. Fica só na VM: nunca no GitHub.

# Endereço do jogo (sem https://), ex.: wildora.dpdns.org
DOMAIN=
# Caddyfile (Cloudflare, padrão) ou Caddyfile.letsencrypt (sem Cloudflare)
CADDYFILE=Caddyfile

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Supabase → Connect → Session pooler (troque a senha). SECRETA.
DATABASE_URL=
